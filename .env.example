# Copy to .env and adjust. .env is git-ignored: never commit real values.

# Server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (required: the server refuses to start without DATABASE_URL)
# ---------------------------------------------------------------------------
# Create the role and the two databases once with `npm run db:init`, then apply
# the schema with `npm run db:migrate` (see docs/DEVELOPMENT.md). Replace
# CHANGE_ME with the password you chose for the "bli" role.
DATABASE_URL=postgres://bli:CHANGE_ME@localhost:5432/bli_dev
# Used only by the automated tests (`npm test`). The database name MUST end in
# "_test": the test helpers refuse to run against anything else.
TEST_DATABASE_URL=postgres://bli:CHANGE_ME@localhost:5432/bli_test
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# "require" for a managed database that demands TLS (certificate is verified).
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. REQUIRED in production, at least 32 characters.
# Several secrets may be listed, comma separated: the first signs new cookies,
# all of them are accepted, which is how a secret is rotated without logging
# everybody out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development it may be left empty (an insecure built-in secret is used).
SESSION_SECRET=
# Sign out after this many days without activity / after this many days no
# matter what (the second one is never extended by activity).
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
# The session cookie is Secure by default (HTTPS only) and is then named
# __Host-bli_sid. Local development runs on plain http://localhost, where the
# server cannot set a Secure cookie, so this example turns it off. NEVER set
# false in production (the server refuses to start if you do).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
# Origins (scheme + host + port) allowed to make state-changing requests
# (POST/PUT/PATCH/DELETE). REQUIRED in production: the public origin of the app,
# e.g. https://app.example.com. Outside production it defaults to the Vite dev
# server (http://localhost:5173) and the API itself.
ALLOWED_ORIGINS=
# Origins allowed to call the API cross-origin from a browser, with cookies.
# Leave EMPTY (the default) when the front end and the API share one origin,
# which is how both development (Vite proxy) and production are meant to run.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (0 = none). Needed behind a TLS
# terminating proxy so that req.ip and "secure" cookies work; set it to the
# exact hop count, never higher.
TRUST_PROXY=0
# Set to false to close sign-ups (existing users can still sign in).
REGISTRATION_ENABLED=true
# Successful analyses each user may run per window (each one can cost several
# billed Google calls when the real providers are on).
ANALYZE_RATE_LIMIT_MAX=30
ANALYZE_RATE_LIMIT_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Google Maps (only required when USE_MOCK_GEOCODING / USE_MOCK_PLACES are false)
# ---------------------------------------------------------------------------
# Get one at https://console.cloud.google.com/ -> enable "Geocoding API" and "Places API (New)"
GOOGLE_MAPS_API_KEY=

# Development mode: no external calls, no cost, deterministic synthetic data.
# Set to false only for a controlled test with the real Google APIs.
USE_MOCK_GEOCODING=true
USE_MOCK_PLACES=true

# Search radius and grid coverage cost controls
MAX_RADIUS_KM=20
GRID_MIN_RADIUS_KM=3
MAX_SEARCH_POINTS=7
MAX_PAGES_PER_POINT=1

# Commercial Ecosystem analysis (complementary businesses + potential traffic
# generators, for business types with a known Business Profile). Adds at most
# 2 extra Places calls per analysis, only when a profile matches. Independent
# of USE_MOCK_PLACES — set to false to keep the existing competitor search
# but skip these extra calls, without touching USE_MOCK_PLACES/GOOGLE_MAPS_API_KEY.
ENABLE_COMMERCIAL_ECOSYSTEM=true

# External HTTP call timeout (ms)
HTTP_TIMEOUT_MS=8000

# Logging
LOG_LEVEL=info
